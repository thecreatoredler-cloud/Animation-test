<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#0d0b14">
<title>Night Shift Benchmark</title>
<style>
  :root { --bg:#0d0b14; --ink:#f4efe6; --accent:#ffb347; }
  * { box-sizing:border-box; margin:0; padding:0; }
  html, body {
    height:100%; background:var(--bg); color:var(--ink); overflow:hidden;
    font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    -webkit-tap-highlight-color:transparent; touch-action:manipulation; user-select:none;
  }
  #stage { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); overflow:hidden; background:#2b2440; }
  #stage canvas { display:block; }
  #hud {
    position:absolute; top:10px; left:10px; padding:6px 8px; border-radius:6px;
    font:11px/1.45 ui-monospace,Menlo,Consolas,monospace; white-space:pre;
    background:rgba(0,0,0,.5); pointer-events:none;
  }
  #title {
    position:absolute; top:18%; left:0; right:0; text-align:center; pointer-events:none;
    transition:opacity .4s; text-shadow:0 2px 10px rgba(0,0,0,.6);
  }
  #title h1 { font-size:30px; letter-spacing:.06em; font-weight:800; }
  #title p { font-size:14px; opacity:.85; margin-top:6px; }
  #summary {
    position:absolute; left:14px; right:14px; bottom:84px; display:none; padding:10px 14px;
    background:rgba(12,9,20,.88); border:1px solid rgba(255,255,255,.16); border-radius:12px;
    font:13px/1.6 ui-monospace,Menlo,Consolas,monospace; white-space:pre-wrap;
  }
  #summary b { color:var(--accent); font-family:system-ui,sans-serif; font-size:15px; }
  #controls {
    position:absolute; left:0; right:0; bottom:calc(18px + env(safe-area-inset-bottom));
    display:flex; justify-content:center; gap:10px;
  }
  button {
    font:700 16px system-ui,sans-serif; border:0; border-radius:999px; min-height:50px;
    padding:0 28px; background:var(--accent); color:#1a1208; box-shadow:0 4px 16px rgba(0,0,0,.45);
  }
  button.ghost { background:rgba(255,255,255,.18); color:var(--ink); padding:0 18px; font-size:14px; }
  button:active { transform:scale(.96); }
  #msg { position:absolute; inset:0; display:none; align-items:center; justify-content:center; padding:24px; text-align:center; background:rgba(0,0,0,.8); font-size:15px; line-height:1.5; }
</style>
</head>
<body>
<div id="stage">
  <div id="hud">loading…</div>
  <div id="title"><h1>NIGHT SHIFT</h1><p>5-second visual benchmark</p></div>
  <div id="summary"></div>
  <div id="controls">
    <button id="play" disabled>▶ Start</button>
    <button id="restart" class="ghost">↺</button>
    <button id="hudBtn" class="ghost">HUD</button>
  </div>
  <div id="msg"></div>
</div>

<script>
  // Shown if Three.js cannot load or WebGL fails.
  function showMsg(t){ var m=document.getElementById('msg'); m.textContent=t; m.style.display='flex'; }
  window.addEventListener('error', function(e){ showMsg('Error: ' + (e.message || 'script failed to load')); });
  setTimeout(function(){ if(!window.__ready) showMsg('Could not start. Check your connection (Three.js loads from cdn.jsdelivr.net) and that WebGL is enabled.'); }, 12000);
</script>
