// doors, board, posters
function wallPlane(tex, w, h, side, z, y, basic) {
  const mat = basic ? new THREE.MeshBasicMaterial({ map: tex }) : lam({ map: tex });
  const m = new THREE.Mesh(new THREE.PlaneGeometry(w, h), mat);
  m.rotation.y = side > 0 ? -Math.PI / 2 : Math.PI / 2;
  m.position.set(side * (HALL_W / 2 - 0.01), y, z); m.receiveShadow = !basic;
  scene.add(freeze(m)); return m;
}
